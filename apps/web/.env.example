NEXT_PUBLIC_COMPANY_JURISDICTION="Wyoming, USA"
NEXT_PUBLIC_COMPANY_STATUS=Active
NEXT_PUBLIC_COMPANY_ADDRESS="123 Example St #100, Example City, EX 12345, USA"
NEXT_PUBLIC_COMPANY_EMAIL=contact@example.com
NEXT_PUBLIC_COMPANY_PHONE="+1 (555) 555-0100"
NEXT_PUBLIC_COMPANY_PHONE_E164=+15555550100
NEXT_PUBLIC_COMPANY_FAX="+1 (555) 555-0101"
NEXT_PUBLIC_COMPANY_FAX_E164=+15555550101
NEXT_PUBLIC_COMPANY_WEBSITE=https://example.com
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/15555550100
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Approved public hero media URL. Leave this unset to use the approved fallback.
NEXT_PUBLIC_LAMBTECH_HERO_IMAGE_URL=https://barmentech-saas.atl1.digitaloceanspaces.com/LAMBTECH-WEBSIDE/Hero%20Desktop%20Lambtech%20Web.svg

# Optional authorized partner marks. Separate entries with semicolons, using:
