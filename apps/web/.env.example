# Optional absolute URL used to resolve canonical and hreflang metadata at build time.
SITE_URL=

# Public values below are intentionally safe to render in the browser. Do not
# add private credentials, backend tokens, database URLs or media access keys.
# These values are read during static generation; changes require a rebuild.
